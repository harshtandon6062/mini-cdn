# Copy to .env (run.sh does this for you) and change the values.
# DEMO VALUES ONLY. Passwords: admin/changeme, alice/alice-pass, bob/bob-pass. Never use these in production.

# --- origin ---
ORIGIN_DELAY_MS=300

# --- edge ---
ORIGIN_URL=http://127.0.0.1:8001
ORIGIN_TIMEOUT_SECONDS=5
CACHE_MAX_ENTRIES=100
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=5

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-me-with-a-long-random-string-0123456789
JWT_EXPIRY_MINUTES=15
ADMIN_USERNAME=admin
# bcrypt hash of the admin password. Make a new one with: python scripts/hash_password.py 'new-password'
# Single quotes keep the $ characters literal.
ADMIN_PASSWORD_HASH='$2b$12$ra21QAiYfPVIiY./6TwFOusddQVJoMYeupcdTLzqJzrUXiIQYkq.K'

# --- zero trust gateway ---
# true: every proxied request needs a valid user JWT and must match policy.json. false: plain CDN.
ZERO_TRUST_ENABLED=true
POLICY_FILE=policy.json
# Demo users as JSON (admin is added automatically with role "admin").
USERS='{"alice": {"role": "engineer", "password_hash": "$2b$12$EDtBXin/DPlvnft4CEtlLOjaa.BREAD/hkAEIlWechz92F.GfkWgy"}, "bob": {"role": "intern", "password_hash": "$2b$12$n1DlAyghyYXowtQw3R.7ieaKd90kxyuIEsS56whM1QAE7Zyci.iCK"}}'
